/* Navigation feedback: a thin bar the moment a link or form is used. */
.ws-progress {
    position: fixed; inset: 0 0 auto 0; height: 2px; z-index: 2000; pointer-events: none;
    background: var(--primary); transform-origin: left; transform: scaleX(0); opacity: 0;
}
.ws-progress.run { opacity: 1; transform: scaleX(.86); transition: transform 7s cubic-bezier(.1, .7, .2, 1); }

/* ---------- Touch, small screens, motion preferences ------------------- */
@media (hover: none) {
    .is-workspace .btn:hover, .is-workspace .pagination li a:hover, .is-workspace #heldModalOverlay .held-sale-row:hover { transform: none; }
}
@media (max-width: 700px) {
    .is-workspace .content .page-header { padding-bottom: 14px; }
    .is-workspace .content .mobile-record-ready tbody tr:hover > td:first-child { box-shadow: none; }
    .is-workspace .content .card-head, .is-workspace .content .editor-page .card-head { padding: 16px 18px; }
    .is-workspace .content .card-body { padding: 18px; }
}
@media (prefers-reduced-motion: reduce) {
    .ws-progress.run { transition: none; }
    .is-workspace .btn.is-loading::after { animation-duration: 1.6s !important; }
}
html.reduce-motion .ws-progress.run { transition: none; }
html.reduce-motion .is-workspace .btn.is-loading::after { animation-duration: 1.6s !important; }
