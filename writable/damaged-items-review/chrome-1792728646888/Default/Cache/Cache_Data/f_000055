            border-radius: 8px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }
        .topbar-crumb-text {
            display: flex;
            flex-direction: column;
        }
        .topbar-crumb-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--muted);
            line-height: 1;
        }
        .topbar-crumb-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -.1px;
            line-height: 1.3;
        }

        /* Right side */
        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0;
            height: 100%;
        }

        /* Date/time pill */
        .topbar-datetime {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0 16px;
            height: 100%;
            border-left: 1px solid var(--line);
            color: var(--muted);
            font-size: 12.5px;
            font-weight: 500;
            white-space: nowrap;
        }
        .topbar-datetime svg { opacity: .6; flex-shrink: 0; }

        /* Inventory notification menu */
        .notification-wrap {
            position: relative;
            height: 100%;
            display: flex;
            align-items: center;
            padding: 0 8px;
            border-left: 1px solid var(--line);
        }
        .notification-btn {
            position: relative;
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 10px;
            background: transparent;
            color: var(--muted);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background .15s, color .15s, transform .15s;
        }
        .notification-btn:hover,
        .notification-btn[aria-expanded="true"] {
            background: var(--primary-light);
            color: var(--primary);
        }
        .notification-btn:active { transform: scale(.96); }
        .notification-badge {
            position: absolute;
            top: 2px;
            right: 1px;
            min-width: 17px;
            height: 17px;
            padding: 0 4px;
            border-radius: 999px;
            border: 2px solid var(--surface);
            background: var(--danger);
            color: #fff;
            font-size: 9px;
            line-height: 13px;
            font-weight: 800;
            text-align: center;
        }
        .notification-menu {
            display: none;
            position: absolute;
            top: calc(100% - 6px);
            right: 8px;
            width: min(380px, calc(100vw - 24px));
            overflow: hidden;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            z-index: 250;
        }
        .notification-menu.open { display: block; }
        .notification-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 16px 12px;
            border-bottom: 1px solid var(--line);
        }
        .notification-head strong { display: block; font-size: 14px; color: var(--text); }
        .notification-head span { display: block; margin-top: 2px; font-size: 11.5px; color: var(--muted); }
        .notification-total {
            flex-shrink: 0;
            padding: 4px 9px;
            border-radius: 999px;
            background: var(--danger-bg);
            color: var(--danger-text);
            font-size: 11px;
            font-weight: 800;
        }
        .notification-list { max-height: 360px; overflow-y: auto; }
        .notification-item {
            display: grid;
            grid-template-columns: 34px 1fr 16px;
            align-items: start;
            gap: 10px;
            padding: 13px 16px;
            color: inherit;
            text-decoration: none;
            border-bottom: 1px solid var(--line);
            transition: background .15s;
        }
        .notification-item:last-child { border-bottom: 0; }
        .notification-item:hover { background: var(--surface-2); }
        .notification-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .notification-icon.danger { background: var(--danger-bg); color: var(--danger); }
        .notification-icon.warning { background: var(--warning-bg); color: #d97706; }
        .notification-icon.info { background: var(--primary-light); color: var(--primary); }
        .notification-copy strong { display: block; font-size: 13px; color: var(--text); }
        .notification-copy span { display: block; margin-top: 3px; font-size: 11.5px; line-height: 1.45; color: var(--muted); }
        .notification-arrow { color: var(--muted); margin-top: 9px; }
        .notification-empty {
            padding: 28px 18px;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }
        .notification-empty svg { display: block; margin: 0 auto 9px; color: var(--success); }
        button.notification-item {
            width: 100%;
            border: 0;
            border-bottom: 1px solid var(--line);
            background: transparent;
            text-align: left;
            font: inherit;
            cursor: pointer;
        }
        button.notification-item:last-child { border-bottom: 0; }

        /* Low-stock product popup */
        body.inventory-modal-open { overflow: hidden; }
        .inventory-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 600;
            padding: 24px;
            background: rgba(8, 18, 34, .58);
            align-items: center;
            justify-content: center;
        }
        .inventory-modal.open { display: flex; }
        .inventory-modal-dialog {
            width: min(820px, 100%);
            max-height: min(760px, calc(100vh - 48px));
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 24px 70px rgba(0, 18, 48, .28);
        }
        .inventory-modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px 15px;
            border-bottom: 1px solid var(--line);
        }
        .inventory-modal-title-wrap { min-width: 0; }
        .inventory-modal-title {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--text);
            font-size: 18px;
            font-weight: 800;
        }
        .inventory-modal-title-icon {
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--warning-bg);
            color: #d97706;
        }
        .inventory-modal-subtitle {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12.5px;
            line-height: 1.45;
        }
        .inventory-modal-close {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--surface-2);
            color: var(--muted);
            cursor: pointer;
            transition: background .15s, color .15s, border-color .15s;
        }
        .inventory-modal-close:hover {
            border-color: var(--line-2);
            background: var(--danger-bg);
            color: var(--danger);
        }
        .inventory-modal-tools {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 20px;
            border-bottom: 1px solid var(--line);
            background: var(--surface-2);
        }
        .inventory-modal-count {
            color: var(--text-2);
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }
        .inventory-search-wrap {
            position: relative;
            width: min(340px, 100%);
        }
        .inventory-search-wrap svg {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
        }
        .inventory-search {
            width: 100%;
            height: 39px;
            padding: 0 12px 0 35px;
            border: 1px solid var(--line-2);
            border-radius: 10px;
            background: var(--surface);
            color: var(--text);
            font: inherit;
            font-size: 13px;
            outline: none;
        }
        .inventory-search:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }
        .low-stock-list {
            min-height: 0;
            overflow-y: auto;
            padding: 0 20px 6px;
        }
        .low-stock-row {
            display: grid;
            grid-template-columns: minmax(185px, 1.55fr) minmax(115px, 1fr) 74px 92px 118px 92px;
            gap: 12px;
            align-items: center;
            min-width: 820px;
            padding: 12px 2px;
            border-bottom: 1px solid var(--line);
        }
        .low-stock-row-head {
            position: sticky;
            top: 0;
            z-index: 1;
            padding-top: 11px;
            padding-bottom: 9px;
            background: var(--surface);
            color: var(--muted);
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .45px;
            text-transform: uppercase;
        }
        .low-stock-row:last-of-type { border-bottom: 0; }
        .low-stock-product strong {
            display: block;
            color: var(--text);
            font-size: 13px;
            line-height: 1.35;
        }
        .low-stock-product small {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-family: 'DM Mono', monospace;
            font-size: 10.5px;
        }
        .low-stock-cell {
            min-width: 0;
            color: var(--text-2);
            font-size: 12.5px;
        }
        .low-stock-number { font-family: 'DM Mono', monospace; font-weight: 700; }
        .low-stock-forecast {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 78px;
            padding: 5px 8px;
            border-radius: 8px;
            background: var(--primary-light);
            color: var(--primary);
            font-family: 'DM Mono', monospace;
            font-size: 11.5px;
            font-weight: 800;
            white-space: nowrap;
        }
        .low-stock-forecast.no-demand {
            border: 1px solid var(--line);
            background: var(--surface-2);
            color: var(--muted);
            font-family: 'Inter', system-ui, sans-serif;
            font-feature-settings: 'cv11', 'ss01';
            font-size: 10.5px;
        }
        .low-stock-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 64px;
            padding: 5px 8px;
            border-radius: 999px;
            background: var(--warning-bg);
            color: var(--warning-text);
            font-size: 10.5px;
            font-weight: 800;
            white-space: nowrap;
        }
        .low-stock-badge.out { background: var(--danger-bg); color: var(--danger-text); }
        .low-stock-empty-search {
            display: none;
            padding: 36px 20px;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }
        .inventory-modal-note {
            padding: 10px 20px;
            border-top: 1px solid var(--line);
            background: var(--warning-bg);
            color: var(--warning-text);
            font-size: 11.5px;
            line-height: 1.45;
        }
        .inventory-modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 14px 20px;
            border-top: 1px solid var(--line);
        }
        .inventory-modal-link,
        .inventory-modal-done {
            min-height: 39px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 0 14px;
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
        }
        .inventory-modal-link {
            border: 1px solid var(--primary);
            background: var(--primary);
            color: #fff;
        }
        .inventory-modal-link:hover { background: var(--primary-dark); }
        .inventory-modal-done {
            border: 1px solid var(--line-2);
            background: var(--surface);
            color: var(--text-2);
        }
        .inventory-modal-done:hover { background: var(--surface-2); }

        @media (max-width: 700px) {
            .inventory-modal { padding: 0; align-items: stretch; }
            .inventory-modal-dialog {
                width: 100%;
                max-height: 100vh;
                min-height: 100vh;
                border: 0;
                border-radius: 0;
            }
            .inventory-modal-header { padding: 15px 15px 12px; }
            .inventory-modal-title { font-size: 16px; }
            .inventory-modal-tools {
                align-items: stretch;
                flex-direction: column;
                padding: 11px 15px;
            }
            .inventory-search-wrap { width: 100%; }
            .low-stock-list { padding: 8px 15px; }
            .low-stock-row-head { display: none; }
            .low-stock-row {
                min-width: 0;
                grid-template-columns: 1fr 1fr;
                gap: 9px 14px;
                margin-bottom: 10px;
                padding: 13px;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: var(--surface-2);
            }
            .low-stock-product { grid-column: 1 / -1; padding-bottom: 4px; }
            .low-stock-cell::before {
                content: attr(data-label);
                display: block;
                margin-bottom: 3px;
                color: var(--muted);
                font-size: 9.5px;
                font-weight: 800;
                letter-spacing: .35px;
                text-transform: uppercase;
            }
            .inventory-modal-note { padding: 9px 15px; }
            .inventory-modal-footer { padding: 12px 15px; }
            .inventory-modal-link,
            .inventory-modal-done { min-height: 44px; }
        }

        @media (max-width: 420px) {
            .inventory-modal-footer { flex-direction: column-reverse; align-items: stretch; }
            .inventory-modal-link,
            .inventory-modal-done { width: 100%; }
        }

        /* User section */
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px;
            height: 100%;
            border-left: 1px solid var(--line);
            cursor: default;
            transition: background .15s;
        }
        .topbar-user:hover { background: var(--surface-2); }

        .user-avatar {
            width: 34px; height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--primary) 0%, #1a6fe8 100%);
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            letter-spacing: .5px;
        }

        .user-info .user-name { font-size: 13.5px; font-weight: 700; line-height: 1.2; color: var(--text); }
        .user-info .user-role {
            font-size: 11px;
            color: var(--muted);
            font-weight: 500;
        }

        /* Role badge dot */
        .role-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--success);
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(22,163,74,.18);
        }

        /* ── PAGE CONTENT ── */
        .content { flex: 1; padding: 30px 24px 48px; }

        /* ── COMPONENTS ── */
        .page-header { margin-bottom: 22px; }
        .page-header h1 { font-family: var(--heading-font); font-size: 28px; font-weight: 800; letter-spacing: -.035em; color: var(--text); }
        .page-header p { font-size: 14px; color: var(--muted); margin-top: 4px; }

        .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow); }

        .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 20px 24px; border-bottom: 1px solid var(--line); }
        .card-head h2 { font-family: var(--heading-font); font-size: 17px; font-weight: 700; letter-spacing: -.02em; }
        .card-head p { font-size: 13px; color: var(--muted); margin-top: 2px; }
        .card-body { padding: 22px 24px; }

        /* Tables */
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        table th { background: var(--surface-2); font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 13px 16px; text-align: left; white-space: nowrap; border-bottom: 1px solid var(--line); }
        table td { padding: 15px 16px; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--text-2); vertical-align: middle; }
        table tbody tr:last-child td { border-bottom: none; }
        table tbody tr:hover { background: var(--primary-lighter); }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 18px; border: none; border-radius: var(--radius); font-size: 14px; font-weight: 650; font-family: inherit; cursor: pointer; transition: background-color .15s, border-color .15s, color .15s, box-shadow .2s, transform .15s, opacity .15s; line-height: 1; min-height: 42px; white-space: nowrap; }
        .btn:hover { opacity: .88; }
        .btn:active { transform: scale(.98); }
        .btn-primary { background: linear-gradient(180deg, color-mix(in srgb, var(--primary) 86%, #fff), var(--primary)); color: var(--on-primary); box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 8px 18px -8px var(--primary-shadow); }
        .btn-primary:hover { background: var(--primary-dark); opacity: 1; }
        .btn-secondary { background: var(--surface); color: var(--text-2); border: 1px solid var(--line-2); }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-sm { padding: 6px 11px; font-size: 13px; min-height: 32px; }
        .btn-lg { padding: 12px 22px; font-size: 16px; min-height: 46px; }
        .btn-full { width: 100%; }
        .btn.secondary { background: var(--surface-2); color: var(--text-2); border: 1px solid var(--line-2); }
        .btn.danger { background: var(--danger); color: #fff; }
        .btn-success { background: var(--success); color: #fff; }
        .btn-warning { background: #d97706; color: #fff; }
        .btn[disabled], button[disabled] { opacity: .62; cursor: not-allowed; transform: none !important; }
        .inline-action-form { display: inline-flex; margin: 0; }
        .action-group { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .form-help, .hint { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 1.45; }
        .required-mark, .text-danger { color: var(--danger); }
        .field-error { margin-top: 5px; color: var(--danger-text); font-size: 12px; font-weight: 600; }
        .input.is-invalid { border-color: var(--danger); box-shadow: 0 0 0 3px rgba(229,62,62,.1); }
        .empty-state { text-align: center; padding: 34px 18px !important; color: var(--muted); }
        .form-grid-2 { display: grid; grid-template-columns: var(--grid-2col); gap: 14px; }
        .filter-actions { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }

        /* Badges */
        .badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700; letter-spacing: .01em; }
        .badge-success { background: var(--success-bg); color: var(--success-text); }
        .badge-danger { background: var(--danger-bg); color: var(--danger-text); }
        .badge-warning { background: var(--warning-bg); color: var(--warning-text); }
        .badge-neutral { background: var(--surface-2); color: var(--muted); border: 1px solid var(--line); }
        .badge.danger { background: var(--danger); color: #fff; }
        .badge.warning { background: #f59e0b; color: #fff; }

        /* Alerts */
        .alert { padding: 14px 18px; border-radius: var(--radius); font-size: 14px; margin-bottom: 16px; border: 1px solid transparent; font-weight: 500; }
        .alert.success { background: var(--success-bg); color: var(--success-text); border-color: #bbf7d0; }
        .alert.error, .alert.danger { background: var(--danger-bg); color: var(--danger-text); border-color: #fecaca; }
        .alert.warning { background: var(--warning-bg); color: var(--warning-text); border-color: #fde68a; }

        /* Forms */
        .field { margin-bottom: 16px; }
        .field:last-child { margin-bottom: 0; }
        label, .label { display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 5px; }
        input[type="text"], input[type="number"], input[type="password"], input[type="email"], select, textarea, .input { width: 100%; padding: 11px 14px; border: 1px solid var(--line-2); border-radius: var(--radius); font-size: 14px; font-family: inherit; color: var(--text); background: var(--surface); transition: border-color .15s, box-shadow .15s; outline: none; }
        input:focus, select:focus, textarea:focus, .input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(43,127,255,.12); }
        input:disabled, select:disabled { background: var(--surface-2); color: var(--muted); cursor: not-allowed; }

        /* Pagination (CI4 default pager: <nav><ul class="pagination"><li><a>) */
        .paginationWrap { margin-top: 20px; display: flex; justify-content: center; }
        .pagination {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .pagination li { display: flex; }
        .pagination li a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 34px;
            padding: 0 10px;
            border-radius: var(--radius);
            border: 1px solid var(--line-2);
            background: var(--surface);
            color: var(--text-2);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s;
        }
        /* First/Previous/Next/Last: hide the text label (kept for screen readers only)
           and show a compact chevron icon instead, so these render as plain single-box
           circular buttons matching the page-number buttons exactly. */
        .pagination li a[aria-label] {
            width: 34px;
            min-width: 34px;
            padding: 0;
            font-size: 0;
        }
        .pagination li a[aria-label] span {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0,0,0,0);
            white-space: nowrap;
            border: 0;
        }
        .pagination li a[aria-label]::before {
            font-size: 15px;
            font-weight: 700;
            line-height: 1;
        }
        .pagination li a[aria-label="First"]::before   { content: "\00ab"; }
        .pagination li a[aria-label="Previous"]::before { content: "\2039"; }
        .pagination li a[aria-label="Next"]::before     { content: "\203a"; }
        .pagination li a[aria-label="Last"]::before    { content: "\00bb"; }
        .pagination li a:hover { background: var(--primary-light); border-color: var(--primary); color: var(--primary); }
        .pagination li.active a {
            background: var(--primary);
            border-color: var(--primary);
