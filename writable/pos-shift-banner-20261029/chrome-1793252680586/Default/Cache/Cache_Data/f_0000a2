            transition: transform .22s cubic-bezier(.4,0,.2,1);
            overflow: hidden;
            /* right edge separation */
            box-shadow: 1px 0 0 var(--sb-border), 8px 0 40px rgba(0,8,24,0.55);
        }

        .sidebar.open { transform: translateX(0); }

        /* ── Brand / Logo strip ── */
        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            height: 64px;
            padding: 0 15px;
            background: var(--sb-header);
            flex-shrink: 0;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
        }

        /* thin glowing separator line */
        .brand::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--primary) 50%, transparent) 40%, color-mix(in srgb, var(--primary) 72%, white) 60%, transparent 100%);
        }

        .brand-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: linear-gradient(145deg, var(--primary), var(--primary-dark));
            flex-shrink: 0;
            overflow: hidden;
            box-shadow: 0 2px 10px var(--primary-shadow), inset 0 0 0 1px rgba(255,255,255,.15);
        }

        .brand-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .brand-text { min-width: 0; }

        .brand-name {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            letter-spacing: .1px;
            line-height: 1.2;
        }

        .brand-sub {
            font-size: 10px;
            font-weight: 600;
            color: #97a9c1;
            letter-spacing: .8px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* ── Scrollable nav area ── */
        .nav-section {
            flex: 1;
            padding: 10px 10px 6px;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.08) transparent;
        }

        .nav-section::-webkit-scrollbar { width: 2px; }
        .nav-section::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 2px; }

        /* ── Section label ── */
        .nav-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            color: var(--sb-label);
            padding: 14px 8px 6px;
            white-space: nowrap;
            overflow: hidden;
            transition: opacity .2s, max-height .2s, padding .2s;
        }

        /* decorative line after label text */
        .nav-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--sb-border);
            border-radius: 1px;
            min-width: 0;
        }

        /* ── Nav item ── */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 10px;
            color: #b7c5d8;
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            position: relative;
            white-space: nowrap;
            overflow: hidden;
            margin-bottom: 2px;
            transition: background .14s, color .14s;
            letter-spacing: .05px;
        }

        .nav-item:hover {
            background: var(--sb-hover);
            color: rgba(255,255,255,.88);
        }

        .nav-item:hover .nav-icon {
            background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.85);
        }

        /* Active state — pill with blue tint + left bar */
        .nav-item.active {
            background: var(--sb-active);
            color: var(--sb-active-text);
            font-weight: 600;
            border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
        }

        .nav-item.active .nav-icon {
            background: var(--sb-icon-active);
            color: var(--sb-active-text);
        }

        .nav-item.active::before {
            content: '';
            position: absolute;
            left: 0; top: 22%; bottom: 22%;
            width: 3px;
            background: linear-gradient(180deg, color-mix(in srgb, var(--sb-active-bar) 75%, white), var(--sb-active-bar));
            border-radius: 0 3px 3px 0;
        }

