<script>
window._siteUrl = "http://127.0.0.1:56301/";
document.addEventListener('DOMContentLoaded', function () {

    /* ── RESPONSIVE PANEL NAVIGATION ── */
    const mobileMedia = window.matchMedia('(max-width: 1100px)');
    const posPanels = Array.from(document.querySelectorAll('[data-pos-panel]'));
    const posTabs = Array.from(document.querySelectorAll('[data-pos-target]'));
    const hasCartItems = document.querySelectorAll('.cart-row').length > 0;

    function setActivePosPanel(name, persist = true) {
        const safeName = ['products', 'cart', 'payment'].includes(name) ? name : 'products';
        if (!mobileMedia.matches) {
            posPanels.forEach(panel => panel.classList.remove('pos-panel-hidden'));
            return;
        }
        posPanels.forEach(panel => {
            panel.classList.toggle('pos-panel-hidden', panel.dataset.posPanel !== safeName);
        });
        posTabs.forEach(tab => {
            const active = tab.dataset.posTarget === safeName;
            tab.classList.toggle('active', active);
            tab.setAttribute('aria-pressed', String(active));
        });
        if (persist) sessionStorage.setItem('pharxmaco-pos-panel', safeName);
    }

    const savedPanel = sessionStorage.getItem('pharxmaco-pos-panel');
    setActivePosPanel(hasCartItems ? (savedPanel || 'products') : 'products', false);
    posTabs.forEach(tab => tab.addEventListener('click', () => setActivePosPanel(tab.dataset.posTarget)));
    document.addEventListener('click', event => {
        const button = event.target.closest('[data-pos-go]');
        if (button) {
            setActivePosPanel(button.dataset.posGo);
            document.getElementById('posMobileNav').scrollIntoView({ block: 'start' });
            document.querySelector('[data-pos-target="' + button.dataset.posGo + '"]')?.focus({ preventScroll: true });
        }
    });
    if (typeof mobileMedia.addEventListener === 'function') {
        mobileMedia.addEventListener('change', () => setActivePosPanel(sessionStorage.getItem('pharxmaco-pos-panel') || 'products', false));
    } else if (typeof mobileMedia.addListener === 'function') {
        mobileMedia.addListener(() => setActivePosPanel(sessionStorage.getItem('pharxmaco-pos-panel') || 'products', false));
    }

    /* ── PRODUCT CARD SELECT / QUICK ADD ── */
    const quickAddBar  = document.getElementById('quickAddBar');
    const quickAddName = document.getElementById('quickAddName');
    const quickAddQty  = document.getElementById('quickAddQty');
    const quickAddPid  = document.getElementById('quickAddPid');
    const quickAddQtyH = document.getElementById('quickAddQtyHidden');
    const quickAddCancel = document.getElementById('quickAddCancel');
    const prodCards    = document.querySelectorAll('.prod-card');
    let selectedCard   = null;

    function selectCard(card) {
        if (cartActionBusy || cartActionUncertain || checkoutBusy || readPendingCheckout()) return;
        if (selectedCard) {
            selectedCard.classList.remove('selected');
            selectedCard.setAttribute('aria-pressed', 'false');
        }
        selectedCard = card;
        card.classList.add('selected');
        card.setAttribute('aria-pressed', 'true');
        quickAddName.textContent = card.dataset.label;
        quickAddPid.value  = card.dataset.pid;
        quickAddQty.max    = card.dataset.stock;
        quickAddQty.value  = 1;
        quickAddQtyH.value = 1;
        quickAddBar.classList.add('show');
        // Touch users can adjust quantity without opening the on-screen keyboard.
        if (!window.matchMedia('(pointer: coarse)').matches) {
            quickAddQty.focus(); quickAddQty.select();
        }
    }
    function deselect() {
        if (selectedCard) {
            selectedCard.classList.remove('selected');
            selectedCard.setAttribute('aria-pressed', 'false');
            selectedCard = null;
        }
        quickAddBar.classList.remove('show');
    }

    prodCards.forEach(card => {
        card.addEventListener('click', () => {
            if (!card.classList.contains('disabled')) {
                selectedCard === card ? deselect() : selectCard(card);
            }
        });
        card.addEventListener('keydown', (event) => {
            if ((event.key === 'Enter' || event.key === ' ') && !card.classList.contains('disabled')) {
                event.preventDefault();
                card.click();
            }
        });
    });

    function cancelProductSelection() {
        const card = selectedCard;
        deselect();
        if (card?.getClientRects().length) card.focus({preventScroll: true});
    }
    quickAddCancel?.addEventListener('click', cancelProductSelection);
    quickAddQty.addEventListener('input', function () {
        const max = parseInt(this.max || '1', 10);
        let qty = parseInt(this.value || '1', 10);
        if (!Number.isFinite(qty) || qty < 1) qty = 1;
        if (qty > max) qty = max;
        this.value = qty;
        quickAddQtyH.value = qty;
    });
    document.querySelectorAll('[data-quickadd-step]').forEach(button => {
        button.addEventListener('click', () => {
            quickAddQty.value = (parseInt(quickAddQty.value, 10) || 1) + Number(button.dataset.quickaddStep);
            quickAddQty.dispatchEvent(new Event('input', {bubbles: true}));
        });
    });

    /* ── SAVE CURRENT QUANTITIES BEFORE A CART ACTION ── */
    function getCurrentCartItems() {
        const items = {};
        document.querySelectorAll('.cart-row').forEach(row => {
            const pid = row.getAttribute('data-product-id');
            const qty = parseInt(row.querySelector('.cart-qty-input')?.value || 0) || 0;
            if (pid && qty > 0) items[pid] = qty;
        });
        return items;
    }

    // Refresh every csrf_ hidden input on the page with a new token.
    // Called after each AJAX POST so the next full-page form submission
    // uses the current token (CI4 regenerates on every POST).
    function refreshCsrfTokens(name, hash) {
        document.querySelectorAll('input[name^="csrf_"]').forEach(function (el) {
            el.name  = name;
            el.value = hash;
        });
    }

    async function syncCartToServer() {
        const items = getCurrentCartItems();
        if (!Object.keys(items).length) return true;
        const csrfInput = document.querySelector('input[name^="csrf_"]');
        const fd = new FormData();
        if (csrfInput) fd.append(csrfInput.name, csrfInput.value);
        Object.entries(items).forEach(([pid, qty]) => fd.append('items[' + pid + ']', qty));
        try {
            const res = await fetch(window._siteUrl + 'cashier/sales/sync-cart', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            });
            if (res.status === 401) {
                const denied = await res.json().catch(() => ({}));
                window.dispatchEvent(new CustomEvent('pharxmaco:session-ended', {detail: {message: denied.message}}));
                return false;
            }
            if (!res.ok) return false;
            const data = await res.json();
            // Update all CSRF inputs so subsequent form POSTs use the fresh token.
            if (data.csrf_name && data.csrf_hash) {
                refreshCsrfTokens(data.csrf_name, data.csrf_hash);
            }
            return data.success !== false;
        } catch (e) {
            return false;
        }
    }

    /* Cart mutations update only the cart, benefits and held-sale list. */
    let cartActionBusy = false;
    let cartActionUncertain = false;
    let cashierSessionEnded = false;
    const actionStatus = document.getElementById('posActionStatus');
    const actionMessage = document.getElementById('posActionMessage');
    const refreshCartButton = document.getElementById('refreshPosCart');
    const cartControls = '#quickAddForm button, #quickAddQty, .cart-qty-input, .qty-btn, .cart-remove-btn, #cartHeadActions button, #heldSalesList button';

    function showCartMessage(message, error = false, uncertain = false) {
        hideNetworkMessage();
        document.querySelectorAll('.pos-alert').forEach(alert => alert.remove());
        document.getElementById('posActionStartShift').hidden = true;
        actionStatus.hidden = false;
        actionStatus.classList.toggle('error', error);
        actionStatus.classList.toggle('success', !error);
        actionMessage.textContent = message;
        refreshCartButton.hidden = !uncertain;
    }

    function setCartBusy(busy) {
        cartActionBusy = busy;
        document.getElementById('posCart').setAttribute('aria-busy', String(busy));
        lockCartControls(busy || cartActionUncertain || checkoutBusy);
        refreshAll();
    }

    function lockCartControls(busy) {
        document.querySelectorAll(cartControls).forEach(control => {
            if (busy) {
                if (control.dataset.posWasDisabled === undefined) control.dataset.posWasDisabled = String(control.disabled);
                control.disabled = true;
            } else if (control.dataset.posWasDisabled !== undefined) {
                control.disabled = control.dataset.posWasDisabled === 'true';
                delete control.dataset.posWasDisabled;
            }
        });
    }

    function resetCustomerDetails() {
        discountSelect.value = 'auto';
        for (const id of ['amountPaidInput', 'referenceNoInput', 'saleNotes', 'beneficiaryName', 'beneficiaryId']) {
            const input = document.getElementById(id);
            if (input) input.value = '';
        }
        benefitVerified.checked = false;
        document.querySelectorAll('.benefit-product').forEach(input => { input.checked = false; });
        document.querySelector('.pay-method[data-method="cash"]')?.click();
        try { sessionStorage.removeItem('pharxmaco-pos-discount'); } catch (error) {}
    }

    function applyCartSnapshot(result) {
        const checked = new Set([...document.querySelectorAll('.benefit-product:checked')].map(input => input.dataset.productId));
        const choice = discountSelect.value;
        const listScroll = document.getElementById('cartItemList')?.scrollTop || 0;
        const heldScroll = document.getElementById('heldSalesList').scrollTop;
        const active = document.activeElement;
        const focusProduct = active?.closest('.cart-row')?.dataset.productId;
        document.getElementById('posCartLines').innerHTML = result.cart_html;
        document.getElementById('benefitProductList').innerHTML = result.benefit_html;
        document.getElementById('heldSalesList').innerHTML = result.held_html;
        discountSelect.innerHTML = result.discount_options_html;
        if ([...discountSelect.options].some(option => option.value === choice)) discountSelect.value = choice;
        discountSelect.dataset.selectionScope = result.selection_scope;
        productPromotions = result.promotions;
        document.querySelectorAll('.benefit-product:not([data-unavailable])').forEach(input => { input.checked = checked.has(input.dataset.productId); });
        document.getElementById('cartHeadActions').hidden = result.cart_count === 0;
        document.querySelector('[data-pos-go="payment"]').disabled = result.cart_count === 0;
        document.getElementById('heldSalesCount').textContent = result.held_count;
        document.getElementById('heldSalesTrigger').hidden = result.held_count === 0;
        if (result.held_count === 0) window.PharxmacoModal?.close(document.getElementById('heldModalOverlay'));
        if (checkoutTokenInput && result.checkout_token) checkoutTokenInput.value = result.checkout_token;
        if (result.csrf_name && result.csrf_hash) refreshCsrfTokens(result.csrf_name, result.csrf_hash);
        if (result.new_customer || result.cart_count === 0) {
            resetCustomerDetails();
            deselect();
        }
        bindCartQuantities();
        const list = document.getElementById('cartItemList');
        if (list) list.scrollTop = listScroll;
        document.getElementById('heldSalesList').scrollTop = heldScroll;
        if (focusProduct) {
            [...document.querySelectorAll('.cart-row')].find(row => row.dataset.productId === focusProduct)
                ?.querySelector('.cart-qty-input')?.focus({preventScroll: true});
        }
        refreshAll();
    }

    async function readCartResponse(response) {
        // Never follow an authentication/error redirect into a full-page reload.
        if (response.redirected || !(response.headers.get('Content-Type') || '').includes('application/json')) {
            throw new Error('The server did not return a cart result.');
        }
        const result = await response.json();
        if (response.status === 401) {
            cashierSessionEnded = true;
            window.dispatchEvent(new CustomEvent('pharxmaco:session-ended', {detail: {message: result.message}}));
            return null;
        }
        if (result.redirect_url) {
            showCartMessage(result.message || 'Start a shift before continuing.', true);
            document.getElementById('posActionStartShift').hidden = false;
            return null;
        }
        if (typeof result.success !== 'boolean' || typeof result.cart_html !== 'string'
            || typeof result.benefit_html !== 'string' || typeof result.held_html !== 'string'
            || typeof result.discount_options_html !== 'string' || !Array.isArray(result.promotions)
            || !Number.isInteger(result.cart_count) || !Number.isInteger(result.held_count)
            || !response.ok && result.success) throw new Error('Cart state was not confirmed.');
        return result;
    }

    async function submitCartAction(form) {
        if (cartActionBusy || cartActionUncertain || checkoutBusy || readPendingCheckout()) return;
        if (!navigator.onLine) { showCartMessage('Reconnect before changing the cart. Your current entries were kept.', true); return; }
        const action = new URL(form.action).pathname.split('/').filter(Boolean);
        const kind = action.find(value => ['add-to-cart','remove-cart-item','clear-cart','hold-sale','resume-held-sale','discard-held-sale'].includes(value));
        let sent = false;
        setCartBusy(true);
        try {
            if (!await syncCartToServer()) {
                if (cashierSessionEnded) return;
                cartActionUncertain = true;
                showCartMessage('Could not confirm the latest quantities. Refresh the cart before continuing.', true, true);
                return;
            }
            const data = new FormData(form);
            sent = true;
            const result = await readCartResponse(await fetch(form.action, {
                method: 'POST', body: data, credentials: 'same-origin', redirect: 'follow',
                headers: {'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}
            }));
            if (!result) { cartActionUncertain = true; return; }
            applyCartSnapshot(result);
            showCartMessage([result.message, result.warning].filter(Boolean).join(' ') || 'Cart updated.', !result.success);
            if (result.success) {
                if (['hold-sale','clear-cart'].includes(kind)) setActivePosPanel('products');
                else if (['add-to-cart','resume-held-sale'].includes(kind)) setActivePosPanel('cart');
                if (kind === 'add-to-cart') deselect();
                if (kind === 'resume-held-sale') window.PharxmacoModal?.close(document.getElementById('heldModalOverlay'));
            }
        } catch (error) {
            cartActionUncertain = sent;
            showCartMessage(sent
                ? 'The cart action could not be confirmed. Refresh the cart before continuing; do not repeat the action yet.'
                : 'Could not connect. Your current entries were kept.', true, sent);
        } finally {
            setCartBusy(false);
        }
    }

    document.addEventListener('submit', event => {
        const form = event.target;
        const path = new URL(form.action).pathname;
        if (!/\/sales\/(?:add-to-cart|remove-cart-item|clear-cart|hold-sale|resume-held-sale\/\d+|discard-held-sale\/\d+)\/?$/.test(path)) return;
        event.preventDefault();
        if (cartActionBusy || cartActionUncertain || checkoutBusy || readPendingCheckout()) return;
        if (path.includes('clear-cart') && !confirm('Clear the current cart?')) return;
        if (path.includes('discard-held-sale') && !confirm("Discard this held sale? This can't be undone.")) return;
        submitCartAction(form);
    });

    refreshCartButton.addEventListener('click', async () => {
        if (cashierSessionEnded || cartActionBusy || checkoutBusy || readPendingCheckout()) return;
        setCartBusy(true);
        refreshCartButton.disabled = true;
        try {
            const result = await readCartResponse(await fetch(window._siteUrl + 'cashier/sales', {
                credentials:'same-origin', cache:'no-store', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}
            }));
            if (!result) return;
            applyCartSnapshot(result);
            cartActionUncertain = false;
            showCartMessage('Cart refreshed from the server. Review it before continuing.');
        } catch (error) {
            showCartMessage('Could not refresh the cart. Check your connection or sign in again, then retry Refresh cart.', true, true);
        } finally {
            refreshCartButton.disabled = false;
            setCartBusy(false);
        }
    });


    let activeCat = 'all';
    const medicineTypeFilter = document.getElementById('posMedicineType');

    function applyFilters() {
        const q = (searchInput.value || '').toLowerCase().trim();
        if (!q && new URL(window.location.href).searchParams.has('q')) {
            const url = new URL(window.location.href);
            url.searchParams.delete('q');
            window.history.replaceState(window.history.state, '', url);
        }
        let visible = 0;
        prodCards.forEach(card => {
            const inCat = activeCat === 'all' || card.dataset.cat === activeCat;
            const inSearch = !q || card.dataset.name.includes(q) || card.dataset.sku.includes(q) || (card.dataset.generic || '').includes(q);
            const inType = !medicineTypeFilter.value || card.dataset.medicineType === medicineTypeFilter.value;
            const show = inCat && inSearch && inType;
            const next = show ? '' : 'none';
            if (card.style.display !== next) card.style.display = next;   // skip no-op style writes
            if (show) visible++;
        });
        document.getElementById('prodCount').textContent = visible;
        const mobileProductCount = document.getElementById('mobileProductCount');
        if (mobileProductCount) mobileProductCount.textContent = visible;
        const emptyState = document.getElementById('productFilterEmpty');
        if (emptyState) {
            emptyState.hidden = visible !== 0 || (!prodCards.length && !medicineTypeFilter.value && !q && activeCat === 'all');
            document.getElementById('productFilterEmptyText').textContent = medicineTypeFilter.value === 'branded'
                && !Array.from(prodCards).some(card => card.dataset.medicineType === 'branded')
                ? 'No sellable branded products match these filters in this branch. Check branch assignment, available stock and expiry in Products.'
                : 'Try a different name, generic name, SKU, category or medicine type. Only active, in-stock, unexpired products assigned to this branch can be sold.';
        }
        const catalogueEmpty = document.getElementById('posCatalogueEmpty');
        if (catalogueEmpty) catalogueEmpty.hidden = !!medicineTypeFilter.value || !!q;
        document.getElementById('clearProductSearch').hidden = searchInput.value.length === 0;
        document.getElementById('resetProductFilters').hidden = !q && activeCat === 'all' && !medicineTypeFilter.value;
        kbIndex = -1;
        deselect();
    }

    medicineTypeFilter.addEventListener('change', applyFilters);
    document.querySelectorAll('.cat-chip').forEach(chip => {
        chip.addEventListener('click', function () {
            document.querySelectorAll('.cat-chip').forEach(c => {
                c.classList.remove('active');
                c.setAttribute('aria-pressed', 'false');
            });
            this.classList.add('active');
            this.setAttribute('aria-pressed', 'true');
            activeCat = this.dataset.cat;
            applyFilters();
        });
    });

    /* ── SEARCH ── */
    const searchInput = document.getElementById('productSearch');
    let searchTimer, kbIndex = -1;
    document.getElementById('clearProductSearch').addEventListener('click', () => {
        searchInput.value = '';
        applyFilters();
        searchInput.focus();
    });
    document.getElementById('resetProductFilters').addEventListener('click', () => {
        searchInput.value = '';
        activeCat = 'all';
        medicineTypeFilter.value = '';
        document.querySelectorAll('.cat-chip').forEach(chip => {
            const active = chip.dataset.cat === 'all';
            chip.classList.toggle('active', active);
            chip.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
        searchInput.focus();
    });

    function getVisible() { return Array.from(prodCards).filter(c => c.style.display !== 'none' && !c.classList.contains('disabled')); }

    function highlightKb(idx) {
        getVisible().forEach(c => { c.classList.remove('selected'); c.setAttribute('aria-pressed', 'false'); });
        selectedCard = null;
        quickAddBar.classList.remove('show');
        const vis = getVisible();
        if (!vis.length) return;
        idx = Math.max(0, Math.min(idx, vis.length - 1));
        kbIndex = idx;
        vis[idx].scrollIntoView({ block: 'nearest' });
        vis[idx].classList.add('selected');
    }

    searchInput.addEventListener('keydown', function (e) {
        const vis = getVisible();
        if (e.key === 'ArrowDown') { e.preventDefault(); highlightKb(kbIndex < vis.length - 1 ? kbIndex + 1 : vis.length - 1); }
        if (e.key === 'ArrowUp')   { e.preventDefault(); highlightKb(kbIndex > 0 ? kbIndex - 1 : 0); }
        if (e.key === 'Enter' && kbIndex >= 0 && vis[kbIndex] && !vis[kbIndex].classList.contains('disabled')) {
            e.preventDefault(); selectCard(vis[kbIndex]);
        }
    });

    searchInput.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(applyFilters, 150);
    });

    document.addEventListener('keydown', function (event) {
        if (window.PharxmacoModal?.isOpen() || document.getElementById('sidebar')?.classList.contains('open')) return;
        const tag = document.activeElement?.tagName?.toLowerCase();
        const isTyping = ['input', 'textarea', 'select'].includes(tag);
        if (event.key === '/' && !isTyping) {
            event.preventDefault();
            setActivePosPanel('products');
            searchInput.focus();
        }
        if (event.key === 'Escape' && selectedCard) cancelProductSelection();
    });

    /* ── PAYMENT METHOD ── */
    const referenceNoInput = document.getElementById('referenceNoInput');
    const referenceNoLabel = document.getElementById('referenceNoLabel');
    const referenceRules = window.PharxmacoPaymentReference;

