        .nav-icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: var(--sb-icon-bg);
            color: #a6b8cf;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            transition: background .14s, color .14s;
