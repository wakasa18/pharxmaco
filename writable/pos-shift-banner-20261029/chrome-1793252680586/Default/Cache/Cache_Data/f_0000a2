    const promoSelectionKey = 'pharxmaco-pos-discount';
    try {
        const saved = JSON.parse(sessionStorage.getItem(promoSelectionKey) || 'null');
        const savedChoice = saved?.choice === '' ? 'auto' : saved?.choice;
        if (currentCartLineCount > 0 && saved?.scope === discountSelect?.dataset.selectionScope
            && [...discountSelect.options].some(option => option.value === savedChoice)) discountSelect.value = savedChoice;
        else sessionStorage.removeItem(promoSelectionKey);
