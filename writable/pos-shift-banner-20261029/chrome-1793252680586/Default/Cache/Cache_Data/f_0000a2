    function syncPromotionPreview(offers) {
        currentProductPromotions = offers;
        if (autoPromoId) autoPromoId.value = offers.length === 1 ? String(offers[0].id) : '';
        if (autoPromoAmount) autoPromoAmount.value = (offers.reduce((sum,offer) => sum + window.PharxmacoDiscount.cents(offer.amount),0) / 100).toFixed(2);
        if (autoPromoSnapshot) autoPromoSnapshot.value = JSON.stringify(offers.map(offer => ({
            id: offer.id, product_id: offer.productId, amount_cents: window.PharxmacoDiscount.cents(offer.amount)
        })));
    }

    function promotionSummary(offers) {
        const totals = new Map();
        for (const offer of offers) {
            const entry = totals.get(offer.id) || {name:offer.name,cents:0};
            entry.cents += window.PharxmacoDiscount.cents(offer.amount);
            totals.set(offer.id,entry);
        }
        return [...totals.values()].map(offer => offer.name + ': ' + fmt(offer.cents/100) + ' off').join('; ');
    }

    function calcStatutoryDiscount(lines) {
        const fail = message => {
            currentDiscountValid = false;
            if (discountWarning) { discountWarning.textContent = message; discountWarning.classList.add('show'); }
            return 0;
        };
        const selected = [...document.querySelectorAll('.benefit-product:checked:not([data-unavailable])')];
        const eligible = selected.map(box => {
            const line = lines.find(item => item.productId === Number(box.dataset.productId));
            return line ? { ...line, taxTreatment: box.dataset.taxTreatment } : null;
        }).filter(Boolean);
        let result;
        try {
            result = window.PharxmacoDiscount.combinedStatutory(lines, eligible, productPromotions, invoiceTaxStatus, invoiceVatRate);
        }
        catch (error) { return fail(error.message); }
        currentVatExemption = result.vatExemption;
        currentBenefitPlans = result.items;
        currentBenefitTotals = result;
        syncPromotionPreview(result.promotions);
        if (automaticPromoInfo) {
            automaticPromoInfo.hidden = false;
            automaticPromoInfo.textContent = result.promotions.length
                ? promotionSummary(result.promotions) + '. Each product uses its best promo or Senior/PWD treatment.'
                : 'Selected eligible items receive the more favorable Senior/PWD treatment. No additional promo currently lowers this total.';
        }
        if (!eligible.length) {
            fail('Select at least one eligible product for the beneficiary.');
        } else if (beneficiaryName.value.trim().length < 2 || beneficiaryId.value.trim().length < 2 || !benefitVerified.checked) {
            fail('Enter the beneficiary name and ID, then confirm the supporting documents and eligibility.');
        }
        return result.discount;
    }

    function calcDiscount(lines, subtotal) {
        currentDiscountValid = true;
        currentVatExemption = 0;
        currentProductPromotions = [];
        currentBenefitPlans = null;
        currentBenefitTotals = null;
        let sel = discountSelect?.options[discountSelect.selectedIndex];
        const automatic = sel?.value === 'auto';
        if (automaticPromoInfo) automaticPromoInfo.hidden = !automatic;
        if (autoPromoId) autoPromoId.value = '';
        if (autoPromoAmount) autoPromoAmount.value = '0.00';
        if (autoPromoSnapshot) autoPromoSnapshot.value = '[]';

        if (discountWarning) {
            discountWarning.textContent = '';
            discountWarning.classList.remove('show');
        }

        if (automatic) {
            const offers = window.PharxmacoDiscount.productPromotions(lines, productPromotions);
            syncPromotionPreview(offers);
            if (automaticPromoInfo) automaticPromoInfo.textContent = offers.length
                ? promotionSummary(offers) + '. Best qualifying promo per product.'
                : 'No qualifying product or category promo yet. Matching items must meet each promo minimum.';
            return offers.reduce((sum,offer) => sum + window.PharxmacoDiscount.cents(offer.amount),0) / 100;
        }
        if (!sel || !sel.value) return 0;
        if (sel.getAttribute('data-benefit-kind')) return calcStatutoryDiscount(lines);

        const type = sel.getAttribute('data-type');
        const val = parseFloat(sel.getAttribute('data-value') || 0);
        const min = parseFloat(sel.getAttribute('data-minimum') || 0);
        const max = parseFloat(sel.getAttribute('data-max') || 0);
        const scope = sel.getAttribute('data-applies-to') || 'all';
        const categoryId = parseInt(sel.getAttribute('data-category-id') || 0, 10);
        const productId = parseInt(sel.getAttribute('data-product-id') || 0, 10);

        const eligibleCents = lines.reduce((sum, line) => {
            let eligible = scope === 'all';

            if (scope === 'category') {
                eligible = categoryId > 0 && line.categoryId === categoryId;
            } else if (scope === 'product') {
                eligible = productId > 0 && line.productId === productId;
            }

            return eligible ? sum + window.PharxmacoDiscount.cents(line.subtotal) : sum;
        }, 0);
        const eligibleSubtotal = eligibleCents / 100;

        if (eligibleSubtotal <= 0) {
            currentDiscountValid = false;
            if (discountWarning) {
                discountWarning.textContent = 'This discount does not apply to any item in the cart.';
                discountWarning.classList.add('show');
            }
            return 0;
        }

        if (eligibleCents < window.PharxmacoDiscount.cents(min)) {
            currentDiscountValid = false;
            if (discountWarning) {
                discountWarning.textContent = 'Add ' + fmt(min - eligibleSubtotal)
                    + ' more in matching items to qualify (min. ' + fmt(min) + ').';
                discountWarning.classList.add('show');
            }
            return 0;
        }

        const amount = window.PharxmacoDiscount.calculate(eligibleSubtotal, {
            type, value: val, minimum: min, maximum: max > 0 ? max : null
        });
        if (scope === 'product' && amount > 0) currentProductPromotions = [{ productId, amount, name: sel.getAttribute('data-promo-name') }];
        return amount;
    }

    function refreshAll() {
        let total = 0, count = 0;
        const lines = [];

        document.querySelectorAll('.cart-row').forEach(row => {
            const price = parseFloat(row.getAttribute('data-price') || 0);
            const qty = parseInt(row.querySelector('.cart-qty-input')?.value || 0) || 0;
            const sub = window.PharxmacoDiscount.cents(price) * qty / 100;
            const cell = row.querySelector('.cart-subtotal-cell');
            const productId = parseInt(row.getAttribute('data-product-id') || 0, 10);
            const categoryId = parseInt(row.getAttribute('data-category-id') || 0, 10);

            if (cell) cell.textContent = fmt(sub);

            total += sub;
            if (qty > 0) {
                count++;
                lines.push({
                    productId,
                    categoryId,
                    subtotal: sub
                });
            }
        });

        const disc     = calcDiscount(lines, total);
        document.querySelectorAll('.cart-row').forEach(row => {
            const note = row.querySelector('[data-line-promo]');
            if (!note) return;
            const applied = currentProductPromotions.find(offer => Number(row.dataset.productId) === offer.productId);
            const benefit = currentBenefitPlans?.[row.dataset.productId];
            note.hidden = !applied && !benefit?.statutory;
            note.textContent = benefit?.statutory
                ? (discountSelect.value === 'pwd' ? 'PWD' : 'Senior Citizen') + ': −' + fmt(benefit.discount)
                    + (benefit.vatExemption > 0 ? '; VAT removed: −' + fmt(benefit.vatExemption) : '')
                : (applied ? applied.name + ': −' + fmt(applied.amount) : '');
        });
        const finalTot = Math.max(0, window.PharxmacoDiscount.cents(total) - window.PharxmacoDiscount.cents(disc)
            - window.PharxmacoDiscount.cents(currentVatExemption)) / 100;
        const benefitSelected = !!discountSelect?.selectedOptions[0]?.getAttribute('data-benefit-kind');
        if (benefitPanel) {
            benefitPanel.hidden = !benefitSelected;
            benefitPanel.querySelectorAll('input').forEach(input => {
                input.disabled = !benefitSelected || input.hasAttribute('data-unavailable');
                input.required = benefitSelected && ['beneficiaryName','beneficiaryId','benefitVerified'].includes(input.id);
            });
        }
        const vatRow = document.getElementById('coVatExemptionRow');
        if (vatRow) vatRow.hidden = currentVatExemption <= 0;
        const vatAmount = document.getElementById('coVatExemptionAmt');
        if (vatAmount) vatAmount.textContent = '−' + fmt(currentVatExemption);
        const selectedPaymentMethod = document.getElementById('paymentMethodInput')?.value || 'cash';
        const noncash = selectedPaymentMethod !== 'cash';
        if (amountPaidInput) {
            amountPaidInput.readOnly = noncash;
            if (noncash) amountPaidInput.value = finalTot.toFixed(2);
            if (noncash) amountPaidInput.max = finalTot.toFixed(2);
            else amountPaidInput.max = '99999999.99';
        }
        currentPaymentValid = referenceRules.apply(referenceNoInput, selectedPaymentMethod, noncash);
        const paid     = parseFloat(amountPaidInput?.value || 0);
        const change   = noncash ? 0 : Math.max(0, window.PharxmacoDiscount.cents(paid) - window.PharxmacoDiscount.cents(finalTot)) / 100;

        if (grandTotalInput)  grandTotalInput.value = total.toFixed(2);
        if (amountPaidInput)  amountPaidInput.min = finalTot.toFixed(2);
        if (cartTotalDisplay) cartTotalDisplay.textContent = fmt(finalTot);
        if (cartBadge)        cartBadge.textContent = count;
        if (headerCartCount)  headerCartCount.textContent = count;
        if (mobileCartCount)  mobileCartCount.textContent = count;
        if (headerTotal)      headerTotal.textContent = fmt(finalTot);
        if (coItemCount)      coItemCount.textContent = count + ' item' + (count !== 1 ? 's' : '');
        if (coSubtotal)       coSubtotal.textContent = fmt(total);
        if (coDiscountAmt)    coDiscountAmt.textContent = '−' + fmt(disc);
        if (coDiscountRow)    coDiscountRow.style.display = disc > 0 && !currentBenefitTotals ? '' : 'none';
        document.getElementById('coProductPromoRow').hidden = !currentBenefitTotals || currentBenefitTotals.promotionAmount <= 0;
        document.getElementById('coStatutoryRow').hidden = !currentBenefitTotals || currentBenefitTotals.statutoryDiscount <= 0;
        if (currentBenefitTotals) {
            document.getElementById('coProductPromoAmt').textContent = '−' + fmt(currentBenefitTotals.promotionAmount);
            document.getElementById('coStatutoryAmt').textContent = '−' + fmt(currentBenefitTotals.statutoryDiscount);
            document.getElementById('coStatutoryLabel').textContent = (discountSelect.value === 'pwd' ? 'PWD' : 'Senior Citizen') + ' discount';
        }
        if (coFinalTotal)     coFinalTotal.textContent = fmt(finalTot);
        currentFinalTotal = finalTot;

        if (changeRow) {
            if (!noncash && paid > 0 && paid >= finalTot) {
                changeRow.classList.add('show');
                if (changeDisplay) changeDisplay.textContent = fmt(change);
            } else {
                changeRow.classList.remove('show');
            }
        }

        currentCartLineCount = count;
        if (completeSaleBtn && !checkoutBusy) completeSaleBtn.disabled = cartActionBusy || cartActionUncertain || count === 0 || !navigator.onLine || !currentDiscountValid || !currentPaymentValid;
        rebuildHiddenItems();
    }

